{
  "name": "pdf2epub",
  "version": "0.1.15",
  "description": "PDF to EPUB converter for Node.js — reflowable EPUB 3 without Calibre. CLI + API alternative to ebook-convert for text-layer PDFs (Kindle, Kobo, Apple Books).",
  "type": "module",
  "main": "./pdf2epub.js",
  "exports": {
    ".": "./pdf2epub.js"
  },
  "bin": {
    "pdf2epub": "./pdf2epub.js"
  },
  "keywords": [
    "pdf",
    "epub",
    "pdf-to-epub",
    "convert-pdf-to-epub",
    "ebook",
    "reflowable",
    "epub3",
    "kindle",
    "kobo",
    "calibre-alternative",
    "ebook-convert",
    "pdfjs",
    "cli",
    "node"
  ],
  "scripts": {
    "start": "node pdf2epub.js",
    "test": "node test.js",
    "sample": "node lab/import-sample.mjs"
  },
  "author": "dalt4sec",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daltsubnet/pdf2epub.git"
  },
  "bugs": {
    "url": "https://github.com/daltsubnet/pdf2epub/issues"
  },
  "homepage": "https://github.com/daltsubnet/pdf2epub#readme",
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  }
}
